
#///////////////////////////
# Cocos Creator Project
#///////////////////////////

# Cocos Creator 生成的臨時文件和緩存
library/
temp/
local/
profiles/
native/

# 構建輸出
build/
dist/

# Cocos Creator 工作目錄
.creator/

# 編輯器本地設置（保留項目設置）
settings/v2/packages/*.local*
settings/v2/packages/project*.json.bak

#//////////////////////////
# NPM / Node.js
#//////////////////////////
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

#//////////////////////////
# IDE / Editor
#//////////////////////////

# VSCode
.vscode/
*.code-workspace

# WebStorm / IntelliJ
.idea/

# Sublime Text
*.sublime-project
*.sublime-workspace

#//////////////////////////
# OS Generated Files
#//////////////////////////

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

#//////////////////////////
# Logs and Temporary Files
#//////////////////////////
*.log
*.bak
*.tmp
*.swp
*.swo
*~

#//////////////////////////
# OpenCode
#//////////////////////////
.opencode/opencode.json
.opencode/cache/

#//////////////////////////
# Version Control
#//////////////////////////
.git/
.gitattributes
.gitkeep

#//////////////////////////
# Extensions (保留擴展源碼)
#//////////////////////////
# 擴展的 node_modules 但保留擴展本身
extensions/*/node_modules/
extensions/*/dist/
extensions/*/.git/

#//////////////////////////
# Build and Cache
#//////////////////////////
*.meta.bak
*.prefab.bak
*.scene.bak